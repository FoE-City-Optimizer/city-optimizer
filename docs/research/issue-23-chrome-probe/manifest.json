{
  "manifest_version": 3,
  "name": "FoE Issue 23 Boundary Probe (Temporary)",
  "version": "0.0.1",
  "description": "Disposable read-only browser-boundary research on one authorized game world.",
  "background": {
    "service_worker": "runtime.js"
  },
  "content_scripts": [
    {
      "matches": ["https://pl4.forgeofempires.com/game/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://pl4.forgeofempires.com/game/*"],
      "js": ["main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
