{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperimentalCityShape",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "instances"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "instances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "x", "y", "width", "height", "roadRequirement"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 16 },
          "x": { "type": "integer", "minimum": 0, "maximum": 63 },
          "y": { "type": "integer", "minimum": 0, "maximum": 63 },
          "width": { "type": "integer", "minimum": 1, "maximum": 8 },
          "height": { "type": "integer", "minimum": 1, "maximum": 8 },
          "roadRequirement": { "enum": ["NONE", "SINGLE", "DOUBLE"] }
        }
      }
    }
  }
}
